# Copy to .env in the repository root. Environment variables take precedence.
ARCHITECT_AI_ENVIRONMENT=local
ARCHITECT_AI_LOG_LEVEL=INFO
ARCHITECT_AI_DOCS_ENABLED=true
# Optional local MCP boundary; interpreter calls require separate explicit opt-in.
ARCHITECT_AI_MCP_ENABLED=false
ARCHITECT_AI_MCP_LIVE_INTERPRETER_ENABLED=false
# Optional: required only when explicitly using the OpenAI interpreter provider.
OPENAI_API_KEY=
ARCHITECT_AI_OPENAI_MODEL=gpt-6-astra
ARCHITECT_AI_OPENAI_TIMEOUT_SECONDS=30
ARCHITECT_AI_OPENAI_MAX_OUTPUT_TOKENS=6000
